<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.TextAppearance.AppCompat.Widget.ActionBar.Subtitle" parent="@style/TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">@dimen/sesl_toolbar_subtitle_text_size</item>
        <item name="android:textColor">@color/sesl_action_bar_text_color_subtitle_dark</item>
        <item name="fontFamily">@string/sesl_font_family_regular</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.ActionBar.Title" parent="@style/TextAppearance.AppCompat.Title">
        <item name="android:textSize">@dimen/sesl_toolbar_title_text_size</item>
        <item name="android:textStyle">@string/sesl_text_style_medium</item>
        <item name="android:textColor">@color/sesl_action_bar_text_color_title_dark</item>
        <item name="fontFamily">@string/sesl_font_family_medium</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.Button" parent="@style/TextAppearance.AppCompat.Button">
        <item name="android:textStyle">@string/sesl_text_style_medium</item>
        <item name="android:textColor">@color/sesl_btn_text_color_dark</item>
        <item name="fontFamily">@string/sesl_font_family_medium</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.Light.Button" parent="@style/TextAppearance.AppCompat.Button">
        <item name="android:textStyle">@string/sesl_text_style_medium</item>
        <item name="android:textColor">@color/sesl_btn_text_color_light</item>
        <item name="fontFamily">@string/sesl_font_family_medium</item>
    </style>
    <style name="BaseAppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/basics_system_background_209_4_1</item>
        <item name="android:windowFullscreen">@bool/windowFullScreen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="actionBarStyle">@style/Widget.Base.Toolbar.Transparent</item>
        <item name="actionModeBackground">@android:color/transparent</item>
        <item name="actionModeCloseButtonStyle">@style/Widget.Base.ActionButton.CloseMode</item>
        <item name="colorControlActivated">@color/basics_primary_209_4_7</item>
        <item name="colorPrimary">@color/basics_primary_209_4_7</item>
        <item name="colorPrimaryDark">@color/basics_primary_dark_209_4_4</item>
        <item name="isOneUi">true</item>
        <item name="spinnerDropDownItemStyle">@style/Widget.Base.DropDownItem.Spinner</item>
        <item name="spinnerDropdownTextColor">@color/spinner_dropdown_item_text_selector</item>
        <item name="windowActionModeOverlay">true</item>
    </style>
</resources>
